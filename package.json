{
  "name": "paperpaw-workshop",
  "version": "0.1.0-beta.13",
  "description": "Make PaperPaw plugins with AI and try them at once in an emulator",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "app": "tauri dev",
    "app:build": "tauri build",
    "app:installer": "node scripts/installer.mjs",
    "release": "node scripts/release-local.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "handbook": "node handbook/generate.mjs",
    "emulator": "node scripts/emulator.mjs",
    "builder-source": "node scripts/builder-source.mjs",
    "quota-copy": "node scripts/quota-copy.mjs",
    "notices": "node scripts/notices.mjs",
    "notices:check": "node scripts/notices.mjs --check"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "preact": "^11.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^26.6.5",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
