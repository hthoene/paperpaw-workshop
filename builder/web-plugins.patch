+thread_local! {
+    /// Plugins with code compiled into the module, added to the app
+    /// (`set_plugins`, called by a harness crate). PROTOTYPE PATCH.
+    static ADDED: std::cell::Cell<Option<paperpaw_emulator::device::AddPlugins>> = const { std::cell::Cell::new(None) };
+}
+
+/// Adds plugins with code to every device started after.
+pub fn set_plugins(add: paperpaw_emulator::device::AddPlugins) {
+    ADDED.with(|a| a.set(Some(add)));
+}
+
+struct Added;
+impl Added {
+    fn get(&self) -> Option<paperpaw_emulator::device::AddPlugins> {
+        ADDED.with(|a| a.get())
+    }
+}
+static PLUGINS: Added = Added;
