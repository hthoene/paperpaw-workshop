{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperPaw Workshop",
  "version": "0.1.0",
  "identifier": "org.paperpaw.workshop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PaperPaw Workshop",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; frame-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.anthropic.com https://workshop.paperpaw.org"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "PaperPaw",
    "copyright": "PaperPaw contributors, Apache License 2.0",
    "category": "Productivity",
    "shortDescription": "Make PaperPaw plugins by saying what you want",
    "longDescription": "Make your own plugins for your e-reader by saying what you want. The workshop makes the plugin, shows it on PaperPaw's own emulator and checks it as PaperPaw checks plugins.",
    "homepage": "https://paperpaw.org",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/emulator/": "emulator/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "PaperPaw"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBMjRCOTYxNTIxNEQ5M0IKUldRNzJSUlNZYmtrZWxob01jUXlzdkdqUHVWekhTSXhzdmQxdWVRek94bXJ5VVFBcDVseGdZQ3kK",
      "endpoints": [
        "https://github.com/hthoene/paperpaw-workshop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
